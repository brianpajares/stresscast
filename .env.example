# StressCast · entorno local / deployment
# Copia a .env.local. Nunca hagas commit de valores reales.

# App
NEXT_PUBLIC_APP_URL=http://localhost:3000
MONETIZATION_MODE=validation
STRIPE_ENABLED=false
REPORT_TOKEN_SECRET=
GOOGLE_DRIVE_CACHE_TTL_HOURS=24
RATE_LIMIT_REQUESTS_PER_MINUTE=20

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Google Drive service account
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
GOOGLE_DRIVE_FOLDER_ID=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=
OWNER_EMAIL=

# Cloudflare Turnstile
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash rate limit
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Sentry
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=

# Stripe (solo cuando MONETIZATION_MODE=stripe y STRIPE_ENABLED=true)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
